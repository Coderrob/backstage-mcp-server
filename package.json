{
  "author": "Robert Lindley",
  "bin": "dist/cli.cjs",
  "dependencies": {
    "@backstage/catalog-client": "^1.16.2",
    "@backstage/catalog-model": "^1.10.1",
    "@coderrob/mcp-kernel": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@coderrob/eslint-plugin-zero-tolerance": "^1.2.6",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector": "^2.7.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "bats": "^1.13.0",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.5.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.36.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "GPL-3.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "name": "@coderrob/backstage-mcp-server",
  "packageManager": "yarn@4.18.0",
  "sideEffects": false,
  "scripts": {
    "architecture:check": "node scripts/check-source-layout.mjs && madge --circular --extensions ts src",
    "build": "yarn clean && rollup -c",
    "build:dev": "yarn clean && rollup -c --environment NODE_ENV:development",
    "build:validate": "sh -c 'bash scripts/validate-build.sh'",
    "build:watch": "yarn clean && rollup -c --watch",
    "clean": "rimraf dist",
    "deps": "sh -c 'bash scripts/deps.sh'",
    "deps:analyze": "sh -c 'bash scripts/dependency-manager.sh'",
    "deps:audit": "sh -c 'bash scripts/deps.sh audit'",
    "deps:backup": "sh -c 'bash scripts/deps-crossplatform.sh backup'",
    "deps:check": "sh -c 'bash scripts/dependency-manager.sh --dry-run'",
    "deps:crossplatform": "sh -c 'bash scripts/deps-crossplatform.sh'",
    "deps:debug": "sh -c 'bash scripts/dependency-manager.sh --debug'",
    "deps:dedupe": "sh -c 'bash scripts/deps.sh dedupe'",
    "deps:health": "sh -c 'bash scripts/deps-crossplatform.sh health'",
    "deps:info": "sh -c 'bash scripts/deps-crossplatform.sh info'",
    "deps:outdated": "sh -c 'bash scripts/deps.sh outdated'",
    "deps:quick": "sh -c 'bash scripts/deps.sh check'",
    "deps:restore": "sh -c 'bash scripts/deps-crossplatform.sh restore'",
    "deps:update": "sh -c 'bash scripts/deps.sh update'",
    "deps:validate": "sh -c 'bash scripts/deps-crossplatform.sh check'",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore --embedded-language-formatting=off && eslint . --ext .ts,.js,.mjs,.cjs --fix",
    "lint": "eslint . --ext .ts,.js,.mjs,.cjs --max-warnings 0",
    "lint:fix": "prettier . --write && eslint . --ext .ts,.js,.mjs,.cjs --fix",
    "knip": "knip --treat-config-hints-as-errors",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "manifest:print": "node scripts/print-manifest.mjs",
    "manifest:check": "node scripts/check-manifest.mjs",
    "monitor": "sh -c 'bash scripts/monitor.sh'",
    "monitor:alerts": "sh -c 'bash scripts/monitor.sh alerts'",
    "monitor:dashboard": "sh -c 'bash scripts/monitor.sh dashboard'",
    "monitor:sla": "sh -c 'bash scripts/monitor.sh sla'",
    "prepublishOnly": "yarn build",
    "start": "node dist/cli.cjs",
    "start:esm": "node dist/cli.mjs",
    "test": "vitest run --coverage",
    "test:shell": "node scripts/run-bats.mjs",
    "test:cli": "node scripts/smoke-cli.mjs",
    "test:contract": "vitest run src/server.test.ts src/backstage/backstage.plugin.test.ts src/backstage/api/backstage-catalog-api.test.ts",
    "test:inspector": "node scripts/test-inspector.mjs",
    "test:live": "yarn build && node scripts/test-live-backstage.mjs",
    "test:mcp": "yarn test:contract && yarn build && yarn test:cli && yarn test:tools && yarn test:inspector",
    "test:tools": "node scripts/smoke-all-tools.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "docs:check": "node scripts/check-knowledge.mjs && node --test scripts/check-knowledge.test.mjs"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.1.0"
}
