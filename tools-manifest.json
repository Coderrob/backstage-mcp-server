            "minLength": 1
          },
          "dryRun": {
            "type": "boolean"
          },
          "onConflict": {
            "type": "string",
            "enum": [
              "reject",
              "refresh"
            ]
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "data": {}
