{
  "server": {
    "name": "backstage-mcp-server",
    "version": "2.0.0"
  },
  "plugins": [
    {
      "name": "backstage-catalog",
      "version": "2.0.0",
      "description": "Backstage Catalog MCP tools"
    }
  ],
  "features": [
    {
      "kind": "tool",
      "name": "add_location",
      "plugin": "backstage-catalog",
      "title": "Add a catalog location",
      "description": "Add a location to the Backstage catalog, or validate it using dry-run mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "dryRun": {
            "type": "boolean"
          },
          "onConflict": {
            "type": "string",
            "enum": [
              "reject",
              "refresh"
            ]
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "data": {}
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "policy": {
        "timeoutMs": 30000,
        "rateLimit": {
          "maxRequests": 50,
          "windowMs": 60000
        },
        "invalidates": [
          "catalog"
        ]
      }
    },
    {
      "kind": "tool",
      "name": "get_entities",
      "plugin": "backstage-catalog",
      "title": "Get catalog entities",
      "description": "Query Backstage catalog entities with filters, full-text search, ordering, and cursor pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "orderFields": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "field",
                  "order"
                ],
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "order"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "fullTextFilter": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "term"
            ],
            "additionalProperties": false
          },
          "totalItems": {
            "type": "string",
            "enum": [
              "include",
              "exclude"
            ]
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "data": {}
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "policy": {
        "timeoutMs": 30000,
        "cache": {
          "ttlMs": 120000,
          "tags": [
            "catalog"
          ]
        }
      }
    },
    {
      "kind": "tool",
      "name": "get_entity_by_ref",
      "plugin": "backstage-catalog",
      "title": "Get a catalog entity",
      "description": "Get one Backstage catalog entity by its compound reference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entityRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "namespace",
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "entityRef"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "data": {}
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "policy": {
        "timeoutMs": 30000,
        "cache": {
          "ttlMs": 120000,
          "tags": [
            "catalog"
          ]
        }
      }
    }
  ]
}
