        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "policy": {
        "timeoutMs": 30000,
        "rateLimit": {
          "maxRequests": 50,
          "windowMs": 60000
        },
        "invalidates": [
          "catalog"
